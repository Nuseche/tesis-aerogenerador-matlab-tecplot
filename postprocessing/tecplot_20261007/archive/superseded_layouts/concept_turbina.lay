#!MC 1410
$!VarSet |LFDSFN1| = '"../data/concept_turbina.plt"'
$!SetStyleBase Factory
$!BasicColor 
  Custom1
    {
    R = 0
    G = 114
    B = 178
    }
  Custom2
    {
    R = 213
    G = 94
    B = 0
    }
  Custom3
    {
    R = 0
    G = 158
    B = 115
