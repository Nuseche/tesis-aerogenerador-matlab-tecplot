    {
    Color = Custom7
    LineThickness = 0.2
    }
  Symbols
    {
    Show = No
    SymbolShape
      {
      GeomShape = LTri
      }
    Color = Custom7
    FillMode = UseSpecificColor
    FillColor = White
    Size = 0.85
