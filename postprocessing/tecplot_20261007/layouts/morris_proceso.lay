    }
  ViewportTopSnapTarget = 93
$!XYLineAxis 
  XDetail 1
    {
    ShowAxis = No
    CoordScale = Linear
    RangeMin = -0.3580000000000004845
    RangeMax = 10.35800000000000054
    GRSpacing = 2
    TickLabel
      {
      TextShape
        {
        SizeUnits = Point
        Height = 10
        }
      }
