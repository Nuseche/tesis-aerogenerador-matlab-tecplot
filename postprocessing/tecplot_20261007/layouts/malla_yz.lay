#!MC 1410
$!VarSet |LFDSFN1| = '"../data/malla_yz.plt"'
$!SetStyleBase Factory
$!BasicColor 
  Custom1
    {
    R = 20
    G = 20
    B = 20
    }
  Custom2
    {
    R = 90
    G = 90
    B = 90
    }
  Custom3
    {
    R = 45
    G = 45
    B = 45
    }
  Custom4
    {
    R = 115
    G = 115
    B = 115
    }
  Custom5
    {
    R = 150
    G = 150
    B = 150
    }
  Custom6
    {
    R = 175
    G = 175
    B = 175
    }
  Custom7
    {
    R = 30
    G = 30
    B = 30
    }
  Custom8
    {
    R = 200
    G = 200
    B = 200
    }
$!GlobalPaper 
  PaperSizeInfo
    {
    Letter
      {
      Width = 8.5
      Height = 11
      LeftHardClipOffset = 0.125
      RightHardClipOffset = 0.125
      TopHardClipOffset = 0.125
      BottomHardClipOffset = 0.125
      }
    }
$!Page 
  Name = ''
  PaperAttributes
    {
    BackgroundColor = White
    IsTransparent = Yes
    OrientPortrait = No
    ShowGrid = Yes
    ShowRuler = No
    ShowPaper = No
    PaperSize = Letter
    RulerSpacing = OneInch
    PaperGridSpacing = HalfInch
    RegionInWorkArea
      {
      X1 = 1
      Y1 = 0.25
      X2 = 10
      Y2 = 8.25
      }
    }
### Frame Number 1 ###
$!ReadDataSet  '|LFDSFN1|'
  InitialPlotType = XYLine
  IncludeText = No
  IncludeGeom = No
$!RemoveVar |LFDSFN1|
$!FrameLayout 
  ShowBorder = No
  ShowHeader = No
  HeaderColor = Red
  XYPos
    {
    X = 1
    Y = 0.25
    }
  Width = 5.5
  Height = 6.5
$!ThreeDAxis 
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
$!PlotType  = XYLine
$!FrameName  = 'Frame 001'
$!GlobalTime 
  SolutionTime = 0
$!DeleteLineMaps 
$!ActiveLineMaps  =  [1-133]
$!GlobalLinePlot 
  DataLabels
    {
    DistanceSkip = 5
    }
  Legend
    {
    TextShape
      {
      IsBold = No
      SizeUnits = Point
      Height = 10
      }
    XYPos
      {
      X = 99
      Y = 87
      }
    }
$!LineMap  [1]
  Assign
    {
    Zone = 1
    XAxisVar = 1
    YAxisVar = 2
    ShowInLegend = Never
    }
  Lines
    {
    Color = Custom7
    LineThickness = 0.3
    }
  Symbols
    {
    Show = No
    SymbolShape
      {
      GeomShape = LTri
      }
    Color = Custom7
    FillMode = UseSpecificColor
    FillColor = White
    Size = 0.85
    }
  BarCharts
    {
    Color = Red
    FillColor = Red
    }
  ErrorBars
    {
    Color = Red
    }
