    {
    Y1 = 16
    X2 = 94
    Y2 = 94
    }
  ViewportTopSnapTarget = 94
$!XYLineAxis 
  XDetail 1
    {
    CoordScale = Linear
    RangeMin = 0.86499999999999999112
    RangeMax = 1.1350000000000000089
    GRSpacing = 0.05
    TickLabel
      {
      TextShape
        {
        SizeUnits = Point
        Height = 10
        }
      }
    Gridlines
      {
      Show = Yes
      Color = Custom8
      LineThickness = 0.06
      }
