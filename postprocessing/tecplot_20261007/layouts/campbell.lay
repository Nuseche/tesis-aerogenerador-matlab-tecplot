$!XYLineAxis 
  DepXToYRatio = 1
  ViewportPosition
    {
    Y1 = 16
    X2 = 70
    Y2 = 94
    }
  ViewportTopSnapTarget = 94
$!XYLineAxis 
  XDetail 1
    {
    CoordScale = Linear
    RangeMin = -0.95999999999999996447
    RangeMax = 12.960000000000000853
    GRSpacing = 2
    TickLabel
      {
      TextShape
        {
        SizeUnits = Point
        Height = 10
        }
      }
    Gridlines
      {
      Show = Yes
      Color = Custom8
      LineThickness = 0.06
      }
    Title
      {
      TitleMode = UseText
      Text = 'Velocidad [rpm]'
      TextShape
        {
        IsBold = No
        SizeUnits = Point
        Height = 11
        }
      Offset = 6
      }
    }
$!XYLineAxis 
  YDetail 1
    {
    CoordScale = Linear
    RangeMin = 0.038659557141437358996
    RangeMax = 1.7235522866964290145
    GRSpacing = 0.5
    TickLabel
      {
      TextShape
        {
        SizeUnits = Point
        Height = 10
        }
      }
    Gridlines
      {
      Show = Yes
      Color = Custom8
      LineThickness = 0.06
      }
    Title
      {
      TitleMode = UseText
      Text = 'Frecuencia amortiguada [Hz]'
      TextShape
        {
        IsBold = No
        SizeUnits = Point
        Height = 11
        }
      Offset = 9
      }
    }
$!LinePlotLayers 
  ShowSymbols = Yes
$!FrameControl ActivateByNumber
  Frame = 1
$!SetStyleBase Config
