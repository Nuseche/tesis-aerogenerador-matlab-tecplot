    {
    Y1 = 16
    X2 = 94
    Y2 = 94
    }
  ViewportTopSnapTarget = 94
$!XYLineAxis 
  XDetail 1
    {
    CoordScale = Linear
    RangeMin = -10
    RangeMax = 16
    GRSpacing = 5
